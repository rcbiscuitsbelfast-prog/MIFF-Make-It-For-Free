{
  "name": "simple-game-tutorial",
  "version": "1.0.0",
  "description": "A simple 2D platformer game tutorial using the MIFF Framework",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "start": "npm run build && node dist/main.js",
    "serve": "http-server . -p 8080 -o"
  },
  "keywords": [
    "game",
    "tutorial",
    "miff",
    "framework",
    "typescript",
    "2d",
    "platformer"
  ],
  "author": "MIFF Framework",
  "license": "MIT",
  "dependencies": {
    "miff-framework": "file:../../"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "http-server": "^14.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}