{
  "abilities": {
    "kill": {
      "name": "Eliminate",
      "description": "Remove a player from the game permanently",
      "cooldown": 86400000,
      "targetRequired": true,
      "targetFilter": "alive_players",
      "successRate": 0.9,
      "effects": [
        {
          "type": "elimination",
          "target": "single",
          "message": "{user} eliminated {target}"
        },
        {
          "type": "suspicion_increase",
          "target": "user",
          "amount": 25
        }
      ]
    },
    "investigate": {
      "name": "Investigate",
      "description": "Learn the true role of another player",
      "cooldown": 86400000,
      "targetRequired": true,
      "targetFilter": "all_players",
      "successRate": 1.0,
      "effects": [
        {
          "type": "role_reveal",
          "target": "single",
          "message": "{target} is {role}"
        },
        {
          "type": "trust_increase",
          "target": "user",
          "amount": 15
        }
      ]
    },
    "protect": {
      "name": "Protect",
      "description": "Prevent a player from being eliminated",
      "cooldown": 43200000,
      "targetRequired": true,
      "targetFilter": "teammates",
      "successRate": 0.8,
      "effects": [
        {
          "type": "protection",
          "target": "single",
          "duration": 86400000,
          "message": "{user} protected {target}"
        }
      ]
    },
    "block": {
      "name": "Block",
      "description": "Prevent a player from using abilities",
      "cooldown": 43200000,
      "targetRequired": true,
      "targetFilter": "all_players",
      "successRate": 0.7,
      "effects": [
        {
          "type": "ability_block",
          "target": "single",
          "duration": 43200000,
          "message": "{user} blocked {target}'s abilities"
        }
      ]
    },
    "redirect": {
      "name": "Redirect Vote",
      "description": "Change the target of another player's vote",
      "cooldown": 129600000,
      "targetRequired": true,
      "targetFilter": "all_players",
      "successRate": 0.6,
      "effects": [
        {
          "type": "vote_redirect",
          "target": "single",
          "duration": 86400000,
          "message": "{user} redirected {target}'s vote"
        }
      ]
    },
    "heal": {
      "name": "Heal",
      "description": "Restore a player to life",
      "cooldown": 172800000,
      "targetRequired": true,
      "targetFilter": "dead_players",
      "successRate": 0.5,
      "effects": [
        {
          "type": "revive",
          "target": "single",
          "message": "{user} revived {target}"
        }
      ]
    },
    "scan": {
      "name": "Scan Room",
      "description": "Get information about multiple players",
      "cooldown": 86400000,
      "targetRequired": false,
      "targetFilter": "none",
      "successRate": 0.9,
      "effects": [
        {
          "type": "mass_reveal",
          "target": "multiple",
          "count": 3,
          "message": "{user} scanned the room and learned about {targets}"
        }
      ]
    },
    "whisper": {
      "name": "Whisper",
      "description": "Send a private message to another player",
      "cooldown": 300000,
      "targetRequired": true,
      "targetFilter": "all_players",
      "successRate": 1.0,
      "effects": [
        {
          "type": "private_message",
          "target": "single",
          "message": "{user} whispered to {target}: {content}"
        }
      ]
    },
    "emergency_meeting": {
      "name": "Emergency Meeting",
      "description": "Force an immediate voting phase",
      "cooldown": 259200000,
      "targetRequired": false,
      "targetFilter": "none",
      "successRate": 1.0,
      "effects": [
        {
          "type": "phase_change",
          "target": "all",
          "newPhase": "voting",
          "message": "{user} called an emergency meeting!"
        }
      ]
    },
    "time_slow": {
      "name": "Time Slow",
      "description": "Increase cooldowns for all players temporarily",
      "cooldown": 172800000,
      "targetRequired": false,
      "targetFilter": "none",
      "successRate": 0.8,
      "effects": [
        {
          "type": "cooldown_increase",
          "target": "all",
          "multiplier": 2.0,
          "duration": 300000,
          "message": "{user} slowed down time for everyone"
        }
      ]
    }
  },
  "roleAbilities": {
    "innocent": [],
    "traitor": ["kill", "block", "redirect"],
    "detective": ["investigate", "scan", "protect"],
    "neutral": ["whisper", "emergency_meeting", "time_slow"],
    "doctor": ["heal", "protect", "block"],
    "psychic": ["scan", "whisper", "redirect"],
    "vigilante": ["kill", "investigate", "emergency_meeting"]
  },
  "abilityFilters": {
    "alive_players": {
      "condition": "player.isAlive === true",
      "description": "Only living players can be targeted"
    },
    "dead_players": {
      "condition": "player.isAlive === false",
      "description": "Only dead players can be targeted"
    },
    "teammates": {
      "condition": "player.role === user.role || player.role === 'innocent'",
      "description": "Only teammates can be targeted"
    },
    "all_players": {
      "condition": "true",
      "description": "Any player can be targeted"
    },
    "none": {
      "condition": "false",
      "description": "No targeting allowed"
    }
  },
  "metadata": {
    "version": "1.0.0",
    "description": "Ability configurations for social deduction system",
    "created": "2024-01-01",
    "author": "MIFF Framework"
  }
}