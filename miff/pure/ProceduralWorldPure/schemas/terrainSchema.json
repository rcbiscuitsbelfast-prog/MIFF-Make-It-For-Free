{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TerrainOptions",
  "type": "object",
  "properties": {
    "seed": { "type": "integer", "minimum": 0 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "noise": { "type": "string", "enum": ["perlin","simplex","worley"] },
    "octaves": { "type": "integer", "minimum": 1, "maximum": 8 },
    "persistence": { "type": "number", "minimum": 0 },
    "lacunarity": { "type": "number", "minimum": 1 },
    "scale": { "type": "number", "minimum": 0.001 }
  },
  "required": ["seed","width","height","noise"],
  "additionalProperties": false
}

