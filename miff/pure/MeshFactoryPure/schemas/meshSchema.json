{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeshParams",
  "type": "object",
  "properties": {
    "type": { "type": "string", "enum": ["tree","rock"] },
    "trunkHeight": { "type": "number", "minimum": 0 },
    "trunkRadius": { "type": "number", "minimum": 0 },
    "trunkSegments": { "type": "integer", "minimum": 3 },
    "canopyRadius": { "type": "number", "minimum": 0 },
    "canopyHeight": { "type": "number", "minimum": 0 },
    "canopySegments": { "type": "integer", "minimum": 3 },
    "radius": { "type": "number", "minimum": 0 },
    "segments": { "type": "integer", "minimum": 3 },
    "noise": { "type": "number", "minimum": 0 },
    "seed": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}

