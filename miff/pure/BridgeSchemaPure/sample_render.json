{
  "schemaVersion": "v1",
  "examples": {
    "npc_rendering": {
      "description": "NPC rendering across all engines",
      "unified": {
        "op": "render",
        "status": "ok",
        "renderData": [
          {
            "id": "npc_001",
            "type": "node",
            "name": "Guard Captain Marcus",
            "position": { "x": 640, "y": 960, "z": 0 },
            "scale": { "x": 1, "y": 1, "z": 1 },
            "rotation": { "x": 0, "y": 0, "z": 0 },
            "asset": "npc_sprite.png",
            "props": {
              "npc_id": "npc_001",
              "behavior_type": "quest_giver",
              "faction": "village_elders",
              "has_quests": true,
              "quest_count": 1
            },
            "engineHints": {
              "unity": {
                "gameObject": "GameObject_npc_001",
                "component": "NPCController",
                "prefab": "NPCPrefab",
                "useECS": false
              },
              "web": {
                "element": "sprite",
                "canvas": "gameCanvas",
                "useWebGL": true
              },
              "godot": {
                "node": "Node2D",
                "script": "NPCController.gd",
                "scene": "NPCScene.tscn",
                "language": "gdscript"
              }
            },
            "children": [
              {
                "id": "npc_001_sprite",
                "type": "sprite",
                "name": "Sprite",
                "position": { "x": 0, "y": 0, "z": 0 },
                "asset": "npc_sprite.png",
                "props": {
                  "texture": "npc_sprite.png",
                  "flip_h": false,
                  "flip_v": false
                }
              }
            ],
            "signals": [
              {
                "name": "npc_interacted",
                "args": ["player_id", "interaction_type"],
                "engineHints": {
                  "unity": "OnNPCInteracted",
                  "web": "npcInteracted",
                  "godot": "npc_interacted"
                }
              }
            ]
          }
        ]
      }
    },
    "combat_rendering": {
      "description": "Combat rendering across all engines",
      "unified": {
        "op": "render",
        "status": "ok",
        "renderData": [
          {
            "id": "combat_001",
            "type": "node",
            "name": "Combat Arena",
            "position": { "x": 320, "y": 480, "z": 0 },
            "scale": { "x": 1, "y": 1, "z": 1 },
            "rotation": { "x": 0, "y": 0, "z": 0 },
            "asset": "combat_bg.png",
            "props": {
              "combat_id": "combat_001",
              "arena_type": "boss_fight",
              "difficulty": "hard"
            }
          }
        ]
      }
    },
    "ui_rendering": {
      "description": "UI rendering across all engines",
      "unified": {
        "op": "render",
        "status": "ok",
        "renderData": [
          {
            "id": "ui_001",
            "type": "ui",
            "name": "Health Bar",
            "position": { "x": 50, "y": 50, "z": 0 },
            "scale": { "x": 1, "y": 1, "z": 1 },
            "rotation": { "x": 0, "y": 0, "z": 0 },
            "asset": "health_bar.png",
            "props": {
              "ui_id": "ui_001",
              "ui_type": "health_bar",
              "max_value": 100,
              "current_value": 75
            }
          }
        ]
      }
    }
  },
  "engine_conversions": {
    "unity_example": {
      "unity_data": {
        "GameObject": "TestObject",
        "Transform": {
          "position": { "x": 100, "y": 200, "z": 0 },
          "rotation": { "x": 0, "y": 0, "z": 0 },
          "scale": { "x": 1, "y": 1, "z": 1 }
        },
        "SpriteRenderer": {
          "sprite": "test_sprite.png"
        }
      }
    },
    "web_example": {
      "web_data": {
        "element": "div",
        "style": {
          "position": "absolute",
          "left": "100px",
          "top": "200px",
          "width": "64px",
          "height": "64px",
          "backgroundImage": "url('test_sprite.png')"
        }
      }
    },
    "godot_example": {
      "godot_data": {
        "node": "Node2D",
        "position": { "x": 100, "y": 200 },
        "scale": { "x": 1, "y": 1 },
        "rotation": 0,
        "texture": "test_sprite.png"
      }
    }
  },
  "validation_examples": {
    "valid_payload": {
      "op": "render",
      "status": "ok",
      "renderData": [
        {
          "id": "valid_sprite",
          "type": "sprite",
          "position": { "x": 100, "y": 200 },
          "asset": "valid.png",
          "props": { "texture": "valid.png" }
        }
      ]
    },
    "invalid_payload": {
      "op": "render",
      "status": "ok",
      "renderData": [
        {
          "id": "invalid_sprite",
          "type": "invalid_type",
          "position": { "x": 100, "y": 200 },
          "asset": "invalid.png"
        }
      ]
    }
  }
}