{
  "name": "miff-framework",
  "version": "1.0.0",
  "description": "MIFF Framework - Modular Interactive Framework for Games",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run build:optimize",
    "build:optimize": "npm run minify && npm run bundle",
    "build:production": "node scripts/build-production.js",
    "minify": "terser dist/**/*.js -o dist/bundle.min.js -c -m",
    "bundle": "webpack --mode=production",
    "dev": "tsc --watch",
    "test": "jest --config jest.pure.config.cjs --coverage --passWithNoTests",
    "test:watch": "jest --config jest.pure.config.cjs --watch",
    "test:ci": "jest --config jest.pure.config.cjs --ci --coverage --watchAll=false",
    "type-check": "tsc --noEmit",
    "lint": "eslint miff/pure/**/*.ts",
    "lint:fix": "eslint miff/pure/**/*.ts --fix",
    "format": "prettier --write miff/pure/**/*.ts",
    "clean": "rimraf dist coverage",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build:production && npm run test:ci",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "deploy:staging": "npm run build:production && npm run test:ci && npm run deploy:staging:deploy",
    "deploy:production": "npm run build:production && npm run test:ci && npm run deploy:production:deploy",
    "deploy:staging:deploy": "node scripts/deploy-production.js --environment=staging",
    "deploy:production:deploy": "node scripts/deploy-production.js --environment=production",
    "health-check": "node scripts/health-check.js",
    "security-scan": "node scripts/security-scan.js",
    "security:audit": "npm audit --audit-level=moderate",
    "performance:monitor": "node scripts/performance-monitor.js",
    "performance:test": "node scripts/performance-test.js",
    "monitor": "node scripts/monitor.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "production:validate": "npm run type-check && npm run lint && npm run test:ci && npm run security-scan",
    "production:deploy": "npm run production:validate && npm run build:production && npm run deploy:production"
  },
  "keywords": [
    "game-framework",
    "modular",
    "typescript",
    "interactive",
    "gaming",
    "miff"
  ],
  "author": "R.C. Biscuits",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "terser": "^5.0.0",
    "ts-jest": "^29.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "files": [
    "dist/**/*",
    "miff/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/miff-framework.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/miff-framework/issues"
  },
  "homepage": "https://github.com/your-org/miff-framework#readme"
}
