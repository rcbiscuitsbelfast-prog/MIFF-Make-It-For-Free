{
  "name": "miff-framework",
  "version": "1.0.0",
  "description": "🌿 MIFF: Make It For Free - A remix-safe, AI-native game ecosystem",
  "main": "index.js",
  "scripts": {
    "test:avatar:translation": "jest --config jest.pure.config.cjs --testPathPattern miff/pure/AvatarSystemPure",
    "test:avatar:layering": "jest --config jest.pure.config.cjs --testPathPattern AvatarRendererWebPure",
    "test:avatar:anchors": "jest --config jest.pure.config.cjs --testPathPattern AvatarRendererGodotPure",
    "test:avatar:ci": "npm run -s test:avatar:translation && npm run -s test:avatar:layering && npm run -s test:avatar:anchors",
    "test:avatar:performance": "jest --config jest.pure.config.cjs --testPathPattern AvatarSystemPure/tests/performance",
    "test:mp:player": "jest --config jest.pure.config.cjs --testPathPattern PlayerStatePure",
    "test:mp:session": "jest --config jest.pure.config.cjs --testPathPattern SessionManifestPure",
    "test:mp:sync": "jest --config jest.pure.config.cjs --testPathPattern SyncManagerPure",
    "test:mp:ci": "npm run -s test:mp:player && npm run -s test:mp:session && npm run -s test:mp:sync",
    "test:pure": "jest --config jest.pure.config.cjs",
    "build": "tsc",
    "dev": "vite",
    "preview": "vite preview",
    "deploy": "npm run build && vercel --prod",
    "test": "jest",
    "test:ci": "jest --coverage",
    "test:dom": "jest --selectProjects dom-tests",
    "test:node": "jest --selectProjects node-tests",
    "test:leak": "jest --detectOpenHandles",
    "gen:html": "node -r ts-node/register miff/scripts/gen-html.ts",
    "gen-toppler": "node miff/scripts/gen-toppler-stub.js",
    "gen-toppler:stub": "node miff/scripts/gen-toppler-stub.js",
    "gen-toppler:full": "ts-node ./miff/scripts/gen-html.ts",
    "ci:recovery": "npm run gen-toppler:stub && npm run test:ci",
    "ci:full": "npm run gen-toppler:full && npm run test:ci",
    "orchestration:validate": "node miff/scripts/validate-orchestration.js",
    "replay:simulate": "node miff/scripts/simulate-replay.js",
    "validate-release": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' cli/miff-simulate.ts TutorialScenarioPure/scenario.json --seed 123 > out_tutorial.json && node miff/scripts/validateOutputFormat.js out_tutorial.json scenario && node miff/scripts/checkRemixHooks.js && node miff/scripts/checkAttribution.js",
    "gen:manifests": "node miff/scripts/gen-manifests.js",
    "audit:games": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/audit-games.ts",
    "serve:site": "node scripts/static-serve.js",
    "audit:canvas": "node scripts/canvas-audit-runner.js",
    "verify:canvas": "node scripts/canvas-smoke-verify.js",
    "ui:screenshots": "node scripts/ui-screenshots.js",
    "validate:modules": "node scripts/validate-modules.js",
    "gen:tests:inventory": "node scripts/generate-tests-inventory.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcbiscuitsbelfast-prog/MIFF-Make-It-For-Free.git"
  },
  "keywords": [
    "game-framework",
    "modular",
    "remix-safe",
    "miff",
    "ai-native",
    "multi-agent",
    "scenario-engine",
    "rpg",
    "spirit-tamer"
  ],
  "author": "MIFF Framework Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rcbiscuitsbelfast-prog/MIFF-Make-It-For-Free/issues"
  },
  "homepage": "https://github.com/rcbiscuitsbelfast-prog/MIFF-Make-It-For-Free#readme",
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.21.5",
    "@babel/preset-typescript": "^7.27.1",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.9",
    "jest": "^29.7.0",
    "sharp": "^0.34.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "commander": "^14.0.0",
    "image-size": "^2.0.2",
    "next": "^15.5.0",
    "next-seo": "^6.8.0",
    "postcss": "^8.5.6",
    "puppeteer": "^22.15.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "ws": "^8.18.0"
  },
  "bin": {
    "miff-avatar": "cli/miff-avatar.ts",
    "miff-session": "cli/miff-session.ts",
    "miff-server": "cli/miff-server.ts",
    "miff-pixel": "cli/miff-pixel.ts",
    "miff-world": "cli/miff-world.ts",
    "miff-export": "cli/miff-export.ts"
  },
  "miffAvatar": {
    "presets": [
      "presets/avatars/barbarian.json",
      "presets/avatars/mage.json",
      "presets/avatars/rogue.json"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "miff": {
    "framework": "v14",
    "scenarios": [
      "spirit-tamer-trial-of-grove"
    ],
    "remix-safe": true,
    "multi-agent": true,
    "ai-native": true
  }
}
