{
  "name": "miff-framework",
  "version": "1.0.0",
  "description": "MIFF Framework - Modular Interactive Framework for Games",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run build:optimize",
    "build:optimize": "npm run minify && npm run bundle",
    "minify": "terser dist/**/*.js -o dist/bundle.min.js -c -m",
    "bundle": "webpack --mode=production",
    "dev": "tsc --watch",
    "test": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "clean": "rimraf dist coverage",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build && npm run test:ci",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "deploy:staging": "npm run build && npm run test:ci && npm run deploy:staging:deploy",
    "deploy:production": "npm run build && npm run test:ci && npm run deploy:production:deploy",
    "deploy:staging:deploy": "echo 'Deploying to staging...'",
    "deploy:production:deploy": "echo 'Deploying to production...'",
    "health-check": "node scripts/health-check.js",
    "security-scan": "npm audit && npm run security:scan",
    "security:scan": "echo 'Running security scan...'",
    "performance:test": "node scripts/performance-test.js",
    "monitor": "node scripts/monitor.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "keywords": [
    "game-framework",
    "modular",
    "typescript",
    "interactive",
    "gaming",
    "miff"
  ],
  "author": "R.C. Biscuits",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "terser": "^5.0.0",
    "ts-jest": "^29.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "miff/pure/**/*.ts",
      "!miff/pure/**/*.test.ts",
      "!miff/pure/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "files": [
    "dist/**/*",
    "miff/**/*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/miff-framework.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/miff-framework/issues"
  },
  "homepage": "https://github.com/your-org/miff-framework#readme"
}