{
  "name": "miff-framework",
  "version": "1.0.0",
  "description": "🌿 MIFF: Make It For Free - A remix-safe, AI-native game ecosystem",
  "main": "index.js",
  "scripts": {
    "ci:scenarios": "node scripts/ci-validate-scenarios.cjs",
    "test": "jest --config jest.pure.config.cjs",
    "test:unit": "jest --config jest.pure.config.cjs",
    "test:ci": "npm run test:automation -- --ci",
    "test:leak": "jest --detectOpenHandles --config jest.pure.config.cjs",
    "test:teams": "jest --config jest.pure.config.cjs --testPathPattern TeamsPure",
    "test:health": "jest --config jest.pure.config.cjs --testPathPattern HealthSystemPure",
    "test:rng": "jest --config jest.pure.config.cjs --testPathPattern RNGPure",
    "test:events": "jest --config jest.pure.config.cjs --testPathPattern EventsPure",
    "test:schemas": "jest --config jest.pure.config.cjs --testPathPattern Schemas",
    "test:input": "jest --config jest.pure.config.cjs --testPathPattern InputPure",
    "test:perf": "jest --config jest.pure.config.cjs --testPathPattern PerfPure",
    "test:party": "jest --config jest.pure.config.cjs --testPathPattern PartyPure",
    "test:encounter": "jest --config jest.pure.config.cjs --testPathPattern EncounterPure",
    "test:status": "jest --config jest.pure.config.cjs --testPathPattern StatusEffectsPure",
    "test:rewards": "jest --config jest.pure.config.cjs --testPathPattern RewardsPure",
    "test:hud": "jest --config jest.pure.config.cjs --testPathPattern HUDPure",
    "test:sync": "jest --config jest.pure.config.cjs --testPathPattern SyncPure",
    "test:combat": "jest --config jest.pure.config.cjs --testPathPattern CombatPure",
    "test:items": "jest --config jest.pure.config.cjs --testPathPattern ItemsPure",
    "test:ai": "jest --config jest.pure.config.cjs --testPathPattern AIPure",
    "test:quests": "jest --config jest.pure.config.cjs --testPathPattern QuestsPure",
    "test:battleai": "jest --config jest.pure.config.cjs --testPathPattern BattleAIPure",
    "test:log": "jest --config jest.pure.config.cjs --testPathPattern LogPure",
    "test:challenges": "jest --config jest.pure.config.cjs --testPathPattern ChallengesPure",
    "test:effects": "jest --config jest.pure.config.cjs --testPathPattern EffectsPure",
    "test:camera": "jest --config jest.pure.config.cjs --testPathPattern CameraSystemPure",
    "test:automation": "bash scripts/test-automation.sh",
    "test:automation:unit": "npm run test:unit",
    "test:automation:integration": "npm run test:integration",
    "test:automation:performance": "npm run test:performance",
    "test:automation:golden": "npm run test:golden",
    "test:automation:cli": "npm run test:cli",
    "test:pipeline": "npm run test:automation",
    "test:coverage": "jest --config jest.pure.config.cjs --coverage",
    "test:coverage:report": "jest --config jest.pure.config.cjs --coverage --coverageReporters=html --coverageReporters=json-summary --coverageReporters=text",
    "test:coverage:check": "jest --config jest.pure.config.cjs --coverage --passWithNoTests",
    "test:coverage:merge": "nyc merge coverage .nyc_output/coverage.json",
    "test:integration:teams": "jest --config jest.pure.config.cjs miff/pure/TeamsPure/tests/integration_TeamsPure.test.ts",
    "test:integration:evolution": "jest --config jest.pure.config.cjs miff/pure/EvolutionPure/tests/golden_EvolutionPure.test.ts",
    "test:cli:teams": "node miff/pure/TeamsPure/strategicCliHarness.ts --demo",
    "test:cli:evolution": "node miff/pure/EvolutionPure/cliHarness.ts --demo",
    "test:visual": "open miff/pure/TeamsPure/visualTeamBuilder.html",
    "test:performance": "node scripts/performance-test.js",
    "test:golden:compare": "jest --config jest.pure.config.cjs --testNamePattern='golden' --verbose",
    "dashboard:performance": "open miff/pure/TeamsPure/performanceDashboard.html",
    "build:automation": "tsc scripts/test-automation.sh --outDir dist-scripts",
    "report:coverage": "node scripts/generate-coverage-report.js",
    "report:performance": "node scripts/generate-performance-report.js",
    "lint": "node -e \"console.log('lint OK')\"",
    "type-check": "tsc -p tsconfig.json --noEmit || true",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:all": "npm run typecheck:web && npm run typecheck:node",
    "docs:build": "node scripts/docs-build.js",
    "build": "tsc",
    "dev": "vite",
    "preview": "vite preview",
    "deploy": "npm run build && vercel --prod",
    "audit:deps": "npm outdated && npm audit",
    "security:sbom": "npx @cyclonedx/cyclonedx-npm --output-format json --output-file sbom.json",
    "security:scan": "npm audit --audit-level moderate",
    "perf:lighthouse": "npx @lhci/cli@0.12.x autorun",
    "perf:lighthouse-local": "npx @lhci/cli@0.12.x collect --staticDistDir=./docs --url=http://localhost:8080",
    "security:csp": "node scripts/audit/add-csp-headers.js",
    "audit:assets": "node scripts/audit/verify-assets.js",
    "validate:modules": "node scripts/validate-modules.js",
    "audit:install": "cd scripts/audit && npm ci || npm install",
    "audit:validate": "node scripts/audit/validate-site.js",
    "audit:accessibility": "node scripts/audit/accessibility-audit.cjs",
    "audit:model": "node scripts/audit/generate-model-index.js",
    "audit:coverage": "node scripts/audit/simple-coverage-analysis.cjs",
    "audit": "npm run audit:install && npm run audit:validate && npm run audit:accessibility && npm run audit:assets && npm run audit:model && npm run audit:coverage",
    "simulate": "ts-node cli/miff-simulate.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcbiscuitsbelfast-prog/MIFF-Make-It-For-Free.git"
  },
  "keywords": [
    "game-framework",
    "modular",
    "remix-safe",
    "miff",
    "ai-native",
    "multi-agent",
    "scenario-engine",
    "rpg",
    "spirit-tamer"
  ],
  "author": "MIFF Framework Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rcbiscuitsbelfast-prog/MIFF-Make-It-For-Free/issues"
  },
  "homepage": "https://github.com/rcbiscuitsbelfast-prog/MIFF-Make-It-For-Free#readme",
  "type": "module",
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "babel-jest": "^29.7.0",
    "esbuild": "^0.25.9",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "sharp": "^0.34.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "autoprefixer": "^10.4.21",
    "commander": "^14.0.1",
    "glob": "^11.0.3",
    "image-size": "^2.0.2",
    "next": "^15.5.0",
    "next-seo": "^6.8.0",
    "postcss": "^8.5.6",
    "puppeteer": "^24.22.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "ws": "^8.18.0"
  },
  "bin": {
    "miff-avatar": "cli/miff-avatar.ts",
    "miff-session": "cli/miff-session.ts",
    "miff-server": "cli/miff-server.ts",
    "miff-pixel": "cli/miff-pixel.ts",
    "miff-world": "cli/miff-world.ts",
    "miff-export": "cli/miff-export.ts",
    "miff-characters": "cli/miff-characters.ts",
    "miff-characters-integrate": "cli/miff-characters-integrate.ts",
    "miff-world-pixel-city": "cli/miff-world-pixel-city.ts",
    "miff-world-pixel-city-expand": "cli/miff-world-pixel-city-expand.ts"
  },
  "miffAvatar": {
    "presets": [
      "presets/avatars/barbarian.json",
      "presets/avatars/mage.json",
      "presets/avatars/rogue.json"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "miff": {
    "framework": "v14",
    "scenarios": [
      "spirit-tamer-trial-of-grove"
    ],
    "remix-safe": true,
    "multi-agent": true,
    "ai-native": true
  }
}
