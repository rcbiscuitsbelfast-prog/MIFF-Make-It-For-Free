{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldState",
  "type": "object",
  "properties": {
    "time": {
      "type": "object",
      "properties": {
        "dayNight": { "type": "string", "enum": ["day","night","dawn","dusk"] },
        "ticks": { "type": "integer", "minimum": 0 }
      },
      "required": ["dayNight","ticks"]
    },
    "flags": { "type": "object", "additionalProperties": { "type": ["boolean","string","number"] } },
    "inventory": { "type": "object", "additionalProperties": { "type": "integer" } }
  },
  "required": ["time","flags"]
}