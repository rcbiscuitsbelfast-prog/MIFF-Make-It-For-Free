{
  "id": "escort_npc",
  "title": "Escort NPC",
  "description": "Guide an NPC safely along a path to the destination.",
  "parameters": { "npcId": "herbalist", "dest": "8x6" },
  "steps": [
    { "type": "follow_path", "npc": "${npcId}", "to": "${dest}" },
    { "type": "avoid_enemies", "radius": 2 }
  ],
  "success": { "effect": { "type": "show_lore", "loreId": "escort_success" } },
  "failure": { "effect": { "type": "start_quest", "questId": "retry_escort" } }
}