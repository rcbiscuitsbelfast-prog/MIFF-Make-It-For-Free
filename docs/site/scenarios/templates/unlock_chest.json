{
  "id": "unlock_chest",
  "title": "Unlock Chest",
  "description": "Find the key and unlock the chest to gain an item.",
  "parameters": { "keyItem": "rusted_key", "chestTile": "chest_red" },
  "steps": [
    { "type": "require_item", "item": "${keyItem}" },
    { "type": "interact_tile", "tile": "${chestTile}", "action": "open_chest" }
  ],
  "success": { "effect": { "type": "grant_item", "item": "rare_gem" } },
  "failure": { "effect": { "type": "show_lore", "loreId": "locked_chest_hint" } }
}