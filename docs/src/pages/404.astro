---
import SimpleLayout from '../layouts/SimpleLayout.astro';
const base = import.meta.env.BASE_URL || '/';
---

<SimpleLayout title="404 — Page Not Found" description="The page you were looking for doesn't exist.">
	<section class="text-center py-12">
		<div class="mb-8 flex flex-col items-center">
			<img src={`${base}image_1758956766781.svg`} alt="MIFF" width="64" height="64" class="rounded-lg mb-4" onerror={`this.onerror=null;this.src='${base}image_1758956766781.jpeg'`} />
			<h1 class="text-3xl font-bold text-purple-700 mb-4">
				404 — Page Not Found
			</h1>
			<p class="text-gray-600 mb-6">
				The page you were looking for doesn't exist. Try one of these instead:
			</p>
		</div>
		
		<div class="flex flex-wrap justify-center gap-4">
			<a 
				href={`${base}`}
				class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 mx-2 transition-colors font-medium"
			>
				🏠 Home
			</a>
			<a 
				href={`${base}modules/`}
				class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 mx-2 transition-colors font-medium"
			>
				🧩 Modules
			</a>
			<a 
				href={`${base}docs/`}
				class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 mx-2 transition-colors font-medium"
			>
				📚 Docs
			</a>
			<a 
				href={`${base}contributors/onboarding`}
				class="bg-purple-600 text-white px-4 py-2 rounded-lg hover:bg-purple-700 mx-2 transition-colors font-medium"
			>
				👥 Contributors
			</a>
		</div>

		<p class="text-sm text-gray-500 mt-8">If you arrived here from the home page, the section may be moving. Please use the main navigation or return <a class="underline" href={`${base}`}>home</a>.</p>
	</section>
</SimpleLayout>