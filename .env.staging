# Staging Environment Configuration
# MIFF Framework - Staging Settings

# Environment
NODE_ENV=staging
ENVIRONMENT=staging

# Application
APP_NAME=MIFF Framework (Staging)
APP_VERSION=1.0.0-staging
APP_PORT=3001
APP_HOST=0.0.0.0

# Security
JWT_SECRET=staging-jwt-secret-key-not-for-production
ENCRYPTION_KEY=staging-encryption-key-not-for-production
SESSION_SECRET=staging-session-secret-not-for-production
CORS_ORIGIN=https://staging.yourdomain.com,http://localhost:3000
CSP_POLICY=default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'

# Database
DB_HOST=staging-db.yourdomain.com
DB_PORT=5432
DB_NAME=miff_staging
DB_USER=miff_staging_user
DB_PASSWORD=staging-database-password
DB_SSL=true
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_TIMEOUT=30000

# Redis
REDIS_HOST=staging-redis.yourdomain.com
REDIS_PORT=6379
REDIS_PASSWORD=staging-redis-password
REDIS_DB=1
REDIS_TTL=1800

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/miff/staging.log
LOG_MAX_SIZE=50MB
LOG_MAX_FILES=5
LOG_COMPRESS=true

# Monitoring
MONITORING_ENABLED=true
METRICS_ENABLED=true
ALERTING_ENABLED=true
HEALTH_CHECK_INTERVAL=60000
PERFORMANCE_MONITORING=true

# Performance
CACHE_ENABLED=true
CACHE_TTL=1800
COMPRESSION_ENABLED=true
GZIP_LEVEL=4
BROTLI_ENABLED=false
CDN_ENABLED=false
CDN_URL=https://staging-cdn.yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=500
RATE_LIMIT_SKIP_SUCCESS=false

# API
API_VERSION=v1
API_PREFIX=/api
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=2
API_RETRY_DELAY=1000

# External Services
EXTERNAL_API_TIMEOUT=15000
EXTERNAL_API_RETRY_ATTEMPTS=2
EXTERNAL_API_RETRY_DELAY=1000

# File Upload
UPLOAD_MAX_SIZE=5MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
UPLOAD_PATH=/var/uploads/miff-staging

# Email
SMTP_HOST=staging-smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=staging@yourdomain.com
SMTP_PASS=staging-smtp-password
EMAIL_FROM=staging@yourdomain.com
EMAIL_REPLY_TO=staging-support@yourdomain.com

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/STAGING/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/STAGING/DISCORD/WEBHOOK
TELEGRAM_BOT_TOKEN=staging-telegram-bot-token
TELEGRAM_CHAT_ID=staging-telegram-chat-id

# Analytics
GOOGLE_ANALYTICS_ID=GA-STAGING-XXXXXXX
MIXPANEL_TOKEN=staging-mixpanel-token
AMPLITUDE_API_KEY=staging-amplitude-api-key

# Error Tracking
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/staging-project-id
BUGSNAG_API_KEY=staging-bugsnag-api-key
ROLLBAR_ACCESS_TOKEN=staging-rollbar-access-token

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_STORAGE=s3
BACKUP_S3_BUCKET=miff-staging-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=staging-s3-access-key
BACKUP_S3_SECRET_KEY=staging-s3-secret-key

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/miff-staging.crt
SSL_KEY_PATH=/etc/ssl/private/miff-staging.key
SSL_CA_PATH=/etc/ssl/certs/miff-staging-ca.crt
SSL_FORCE_HTTPS=false
SSL_HSTS_MAX_AGE=86400

# CDN
CDN_PROVIDER=cloudflare
CDN_ZONE_ID=staging-cloudflare-zone-id
CDN_API_TOKEN=staging-cloudflare-api-token
CDN_PURGE_CACHE=true

# Load Balancing
LOAD_BALANCER_ENABLED=false
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_HEALTH_CHECK=true
LOAD_BALANCER_STICKY_SESSIONS=false

# Clustering
CLUSTER_ENABLED=false
CLUSTER_WORKERS=2
CLUSTER_GRACEFUL_SHUTDOWN=true
CLUSTER_RESTART_ON_CRASH=true

# Debugging
DEBUG=true
DEBUG_NAMESPACE=miff:staging:*
VERBOSE_LOGGING=true
PROFILING_ENABLED=true

# Feature Flags
FEATURE_FLAGS_ENABLED=true
FEATURE_NEW_UI=true
FEATURE_EXPERIMENTAL_API=true
FEATURE_BETA_FEATURES=true

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Staging system is under maintenance. Please try again later.
MAINTENANCE_END_TIME=2025-01-29T00:00:00Z

# Compliance
GDPR_ENABLED=true
CCPA_ENABLED=true
HIPAA_ENABLED=false
SOX_ENABLED=false
PCI_DSS_ENABLED=false

# Audit
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_LEVEL=debug
AUDIT_LOG_RETENTION_DAYS=30
AUDIT_LOG_ENCRYPTION=false

# Development Overrides
DEBUG=true
VERBOSE_LOGGING=true
LOG_LEVEL=debug