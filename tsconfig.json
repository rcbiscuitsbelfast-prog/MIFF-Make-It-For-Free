{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./miff/pure",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "miff/pure/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "badges/**",
    "**/*.test.ts",
    "**/cliHarness.ts",
    "**/cli/**",
    "cli/**",
    "coverage",
    "miff-nextjs/tailwind.config.ts",
    "scenarios/**/*.ts",
    "docs/assets/vendor/**/*.js",
    "**/*.min.js"
  ]
}