{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./miff/pure",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "miff/pure/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/cliHarness.ts",
    "**/cli/**"
  ]
}