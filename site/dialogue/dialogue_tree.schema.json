{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DialogueTree",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string" },
                "next": { "type": "string" },
                "effects": {
                  "type": "array",
                  "items": { "type": "object", "properties": { "type": { "type": "string" }, "arg": {} }, "required": ["type"] }
                }
              },
              "required": ["label"]
            }
          }
        },
        "required": ["id","text"]
      }
    }
  },
  "required": ["id","nodes"]
}