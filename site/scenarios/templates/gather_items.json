{
  "id": "gather_items",
  "title": "Gather Items",
  "description": "Collect a set number of items scattered across the zone.",
  "parameters": { "itemId": "herb_bundle", "count": 3 },
  "steps": [
    { "type": "collect_item", "item": "${itemId}", "count": "${count}" }
  ],
  "success": { "effect": { "type": "grant_reward", "item": "ancient_token" } },
  "failure": { "effect": { "type": "show_lore", "loreId": "gathering_failed" } }
}