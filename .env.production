# Production Environment Configuration
# MIFF Framework - Production Settings

# Environment
NODE_ENV=production
ENVIRONMENT=production

# Application
APP_NAME=MIFF Framework
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-in-production
ENCRYPTION_KEY=your-super-secure-encryption-key-here-change-in-production
SESSION_SECRET=your-super-secure-session-secret-here-change-in-production
CORS_ORIGIN=https://yourdomain.com
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=miff_production
DB_USER=miff_user
DB_PASSWORD=your-secure-database-password-here
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_TIMEOUT=30000

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password-here
REDIS_DB=0
REDIS_TTL=3600

# Logging
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_FILE=/var/log/miff/production.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_COMPRESS=true

# Monitoring
MONITORING_ENABLED=true
METRICS_ENABLED=true
ALERTING_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
PERFORMANCE_MONITORING=true

# Performance
CACHE_ENABLED=true
CACHE_TTL=3600
COMPRESSION_ENABLED=true
GZIP_LEVEL=6
BROTLI_ENABLED=true
CDN_ENABLED=true
CDN_URL=https://cdn.yourdomain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_SKIP_SUCCESS=false

# API
API_VERSION=v1
API_PREFIX=/api
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000

# External Services
EXTERNAL_API_TIMEOUT=10000
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RETRY_DELAY=1000

# File Upload
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf
UPLOAD_PATH=/var/uploads/miff

# Email
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password-here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
MIXPANEL_TOKEN=your-mixpanel-token-here
AMPLITUDE_API_KEY=your-amplitude-api-key-here

# Error Tracking
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id
BUGSNAG_API_KEY=your-bugsnag-api-key-here
ROLLBAR_ACCESS_TOKEN=your-rollbar-access-token-here

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=s3
BACKUP_S3_BUCKET=miff-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your-s3-access-key-here
BACKUP_S3_SECRET_KEY=your-s3-secret-key-here

# SSL/TLS
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/miff.crt
SSL_KEY_PATH=/etc/ssl/private/miff.key
SSL_CA_PATH=/etc/ssl/certs/miff-ca.crt
SSL_FORCE_HTTPS=true
SSL_HSTS_MAX_AGE=31536000

# CDN
CDN_PROVIDER=cloudflare
CDN_ZONE_ID=your-cloudflare-zone-id-here
CDN_API_TOKEN=your-cloudflare-api-token-here
CDN_PURGE_CACHE=true

# Load Balancing
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_ALGORITHM=round_robin
LOAD_BALANCER_HEALTH_CHECK=true
LOAD_BALANCER_STICKY_SESSIONS=false

# Clustering
CLUSTER_ENABLED=true
CLUSTER_WORKERS=auto
CLUSTER_GRACEFUL_SHUTDOWN=true
CLUSTER_RESTART_ON_CRASH=true

# Debugging
DEBUG=false
DEBUG_NAMESPACE=miff:*
VERBOSE_LOGGING=false
PROFILING_ENABLED=false

# Feature Flags
FEATURE_FLAGS_ENABLED=true
FEATURE_NEW_UI=false
FEATURE_EXPERIMENTAL_API=false
FEATURE_BETA_FEATURES=false

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.
MAINTENANCE_END_TIME=2025-01-29T00:00:00Z

# Compliance
GDPR_ENABLED=true
CCPA_ENABLED=true
HIPAA_ENABLED=false
SOX_ENABLED=false
PCI_DSS_ENABLED=false

# Audit
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_LOG_ENCRYPTION=true

# Development Overrides (DO NOT USE IN PRODUCTION)
# These are commented out for security
# DEBUG=true
# VERBOSE_LOGGING=true
# LOG_LEVEL=debug